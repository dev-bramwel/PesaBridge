# Safaricom Daraja Sandbox Credentials
# Get these from https://developer.safaricom.co.ke
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_sandbox_consumer_key
MPESA_CONSUMER_SECRET=your_sandbox_consumer_secret
# Default Safaricom test shortcode:
MPESA_BUSINESS_SHORT_CODE=174379
# Sandbox PassKey (provided on Daraja test credentials page):
MPESA_PASSKEY=your_sandbox_passkey

# Your Ngrok HTTPS forwarding address (e.g. from `ngrok http 8080`)
MPESA_CALLBACK_URL=https://<your-subdomain>.ngrok-free.app/callback

# Default test phone number (e.g., 07XXXXXXXX or 2547XXXXXXXX)
MPESA_TEST_PHONE=
